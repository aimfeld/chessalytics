# PyCharm
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
.idea/

# Abstra
# Abstra is an AI-powered process automation framework.
# Ignore directories containing user credentials, local state, and settings.
# Learn more at https://abstra.io/docs
.abstra/

# Visual Studio Code
#  Visual Studio Code specific template is maintained in a separate VisualStudioCode.gitignore 
#  that can be found at https://github.com/github/gitignore/blob/main/Global/VisualStudioCode.gitignore
#  and can be added to the global gitignore or merged into this file. However, if you prefer, 
#  you could uncomment the following to ignore the entire vscode folder
# .vscode/

# Ruff stuff:
.ruff_cache/

# PyPI configuration file
.pypirc

# Claude Code
.claude/worktrees/

# Cursor
#  Cursor is an AI-powered code editor. `.cursorignore` specifies files/directories to
#  exclude from AI features like autocomplete and code analysis. Recommended for sensitive data
#  refer to https://docs.cursor.com/context/ignore-files
.cursorignore
.cursorindexingignore

# Marimo
marimo/_static/
marimo/_lsp/
__marimo__/

# Benchmark generator numeric artifact (regenerable intermediate consumed by the benchmarks
# SKILL; the committed deliverable is the LLM-narrated reports/benchmark/benchmarks-latest.md)
reports/benchmark/benchmarks-generated.*

# Calibration sweep working dirs (per-preset / per-persona harness ledgers).
# Intermediate measurement output — only the combined *-cells.tsv aggregate and
# the fitted JSON/TS artifacts are committed.
reports/data/sweep-*/
reports/data/persona-sweep-*/
reports/data/persona-recal-*/

# GSD runtime sentinels (dispatch isolation markers)
.gsd/

# SEED-145 (engine_disagreement_study) working data. Bulk ledgers/manifests/logs stay
# local; only the small gate0_* ledgers and the .gz Stage B manifest are committed.
# Blanket-ignoring the study dir instead would silently swallow new SOURCE files.
scripts/engine_disagreement_study/data/*.ndjson
scripts/engine_disagreement_study/data/*.log
scripts/engine_disagreement_study/data/*.bak
!scripts/engine_disagreement_study/data/gate0_*.ndjson
# SEED-153 scan-shard intermediates: the FEN+eval input the Maia scan reads,
# ~3.4 MB gzipped per 2,000-game shard and fully regenerable from the benchmark
# DB by seed153_scan_sample.py. The committed artifacts are the small per-shard
# stats/incidence JSONs and the combined seed153_manifest.ndjson.gz deliverable.
scripts/engine_disagreement_study/data/seed153_scan_shard-*.ndjson.gz

# SEED-153 pre-aligned (contaminated) first run, kept for comparison. Same rules as
# the live data dir: bulk ledgers/manifests/scan shards stay local, the small
# incidence/stats JSONs and the combined manifest .gz stay committed.
scripts/engine_disagreement_study/data/prealigned-run/*.ndjson
scripts/engine_disagreement_study/data/prealigned-run/*.log
scripts/engine_disagreement_study/data/prealigned-run/seed153_scan_shard-*.ndjson.gz

# Analysis notebook chart exports (analysis/README.md, "Sharing charts with Claude")
analysis/out/*
!analysis/out/.gitkeep

# GSD per-session phase lock (written by gsd-tools state.begin-phase)
.planning/milestone.lock
