{
    # Global log filter. This exists because a site-level `log` block's format
    # applies ONLY to `http.log.access.logN` — Caddy's ERROR logger
    # (`http.log.error.logN`), which is exactly what fires on a proxy 502, is
    # routed to the default logger and bypasses it entirely. That gap leaked
    # X-Operator-Token in full on every deploy-window 502 even after the site
    # block was filtered. Keep this block and the site block in sync.
    log {
        format filter {
            wrap json
            fields {
                request>headers delete
                request>uri query {
                    replace token REDACTED
                }
            }
        }
    }

    # Real client IP behind Cloudflare (SEED-161 group 1 / F-01). Since the
    # 2026-08-11 CDN cutover, Caddy's socket peer is a Cloudflare anycast
    # address, not the visitor — so without this block the guest-creation
    # rate limiter (app/routers/auth.py) buckets unrelated visitors together
    # and worker_heartbeats.last_ip records Cloudflare, not the worker host.
    # trusted_proxies tells Caddy to only honor Cf-Connecting-Ip when the
    # peer is inside Cloudflare's published ranges; client_ip_headers then
    # reads the real visitor IP from that header into request.client_ip.
    # Ranges fetched live from https://www.cloudflare.com/ips-v4 and
    # https://www.cloudflare.com/ips-v6 — refresh on drift via
    # bin/check_cloudflare_ips.sh (do not hand-edit without re-fetching).
    servers {
        # BEGIN cloudflare-ranges
        trusted_proxies static \
            173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 \
            141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 \
            197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 \
            104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 \
            2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 \
            2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
        # END cloudflare-ranges
        client_ip_headers Cf-Connecting-Ip
    }
}

flawchess.org, www.flawchess.org {
    redir https://flawchess.com{uri} permanent
}

analytics.flawchess.com {
    # Phase 219 (D-06): the Umami script is loaded cross-origin from the
    # isolated flawchess.com document (COEP require-corp, below) — COEP
    # requires the loaded subresource to opt in via CORP (or pass CORS; the
    # index.html script tag also carries crossorigin="anonymous" as the
    # sanctioned belt-and-suspenders source-side fix, D-06).
    header {
        Cross-Origin-Resource-Policy "cross-origin"
    }

    reverse_proxy umami:3000
}

flawchess.com {
    encode gzip

    # Security response headers (SEED-161 group 2 / F-02). Unconditioned on
    # purpose: Caddy's default directive order always runs `header` before
    # any `handle`, so this one block covers static assets, /api/* and the
    # SPA fallback alike -- do NOT nest this inside handle @static, which
    # would silently narrow the fix to static responses only.
    header {
        # One year, subdomains included; the browser HSTS-list opt-in
        # directive is deliberately left off (D-06). Safe because
        # analytics.flawchess.com is on this same Caddy and already HTTPS.
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        Permissions-Policy "camera=(), microphone=(), geolocation=()"

        # Cross-origin isolation (Phase 219 D-05): unlocks SharedArrayBuffer
        # for the Maia worker's multi-threaded wasm inference
        # (maia-worker.js's chooseWasmThreadCount()). Both headers on a JSON
        # API response are inert, so this unconditioned block covering
        # /api/* alongside static assets and the SPA fallback is harmless.
        # The earlier rationale for withholding these ("severs the Google
        # OAuth popup", Phase 136) is obsolete: Google OAuth is a full-page
        # redirect (LoginForm.tsx/RegisterForm.tsx), which COOP same-origin
        # cannot affect — only popup/opener relationships are governed by it.
        Cross-Origin-Opener-Policy "same-origin"
        Cross-Origin-Embedder-Policy "require-corp"

        # Report-only CSP (D-07): reports violations to Sentry via both the
        # legacy report-uri directive and the newer report-to/
        # Reporting-Endpoints mechanism; enforces nothing. Directive-by-
        # directive evidence is in 216-RESEARCH.md Pattern 3. Flip to an
        # enforcing Content-Security-Policy header only after reviewing a
        # few weeks of Sentry violation reports.
        Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' https://analytics.flawchess.com 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://*.ingest.de.sentry.io https://analytics.flawchess.com blob:; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; report-uri https://o4511084502450176.ingest.de.sentry.io/api/4511084868272208/security/?sentry_key=5ac850dda8e5ec8b838c6dfbf50fc89d; report-to csp-endpoint"
        Reporting-Endpoints "csp-endpoint=\"https://o4511084502450176.ingest.de.sentry.io/api/4511084868272208/security/?sentry_key=5ac850dda8e5ec8b838c6dfbf50fc89d\""
    }

    # Access log. Without this Caddy logs NOTHING about requests, so any status
    # Caddy produces on its own — above all the 502 it returns while the backend
    # container restarts, and any 5xx that therefore never reaches FastAPI or the
    # backend's Sentry — leaves no server-side trace at all. The only evidence was
    # whatever the browser happened to report (FLAWCHESS-64), which is sampled,
    # client-side, and useless for reconstructing an outage after the fact.
    #
    # stdout keeps `docker compose logs caddy` as the single inspection path.
    # Volume is bounded by the `logging:` limits on the caddy service in
    # docker-compose.yml — Docker's json-file default has NO rotation, and this
    # host has no /etc/docker/daemon.json, so without those limits an access log
    # grows until the 160 GB disk fills.
    #
    # SECRET REDACTION. Caddy redacts Authorization and Cookie by default and
    # NOTHING else, and this app carries two credentials those defaults miss:
    #   1. X-Operator-Token — the SHARED remote-worker secret, sent on every
    #      eval-worker poll (app/routers/eval_remote.py:169). Worker polling is
    #      the bulk of API traffic, so it landed in most log lines.
    #   2. ?token= — password-reset links are FRONTEND_URL/auth/reset-password
    #      ?token=<token> (app/users.py:131). That is an SPA route, not /api/*,
    #      so log_skip below does NOT cover it and its query is logged in full.
    #      The token grants account takeover.
    #
    # Drop ALL request headers rather than blacklisting known-secret names.
    # Blacklisting failed twice in one evening (missed the custom header, then
    # missed the error logger), and it silently re-breaks the moment anyone adds
    # an authenticated header. Nothing here needs headers: method, uri, status,
    # duration and the upstream error message are what diagnose a 5xx. This
    # filter does NOT drop the real client IP: since the global trust block
    # above (SEED-161 group 1 / F-01) resolves it via client_ip_headers, Caddy
    # writes it into the top-level request.client_ip field, not under
    # request>headers, so it is written to disk again just as it was before the
    # 2026-08-11 CDN cutover. Accepted (216-01 Task 2, option A): restores
    # per-visitor 5xx attribution, and prod docker log retention is roughly an
    # hour, keeping the exposure window short.
    # The query filter stays because the reset token rides in the URI, not a
    # header — add any future secret query param there.
    log {
        output stdout
        format filter {
            wrap json
            fields {
                request>headers delete
                request>uri query {
                    replace token REDACTED
                }
            }
        }
    }

    # Frontend SPA — serve static files first
    # If the file exists on disk (JS, CSS, images, etc.), serve it directly
    @static file
    handle @static {
        # Static assets are served by Caddy itself and can never 502, so they
        # carry no diagnostic value — and logging every hashed chunk plus the
        # 43.6 MB Maia model would drown the API entries this log exists for.
        log_skip

        root * /srv

        # Service worker and PWA manifest must never be HTTP-cached so browsers
        # detect new deployments immediately on every page load (SW spec requires
        # revalidation, but no-cache enforces it on every request, not just every 24h).
        # /push-sw.js joins this matcher too: it is pulled in by the generated
        # service worker via importScripts(), an ordinary sub-resource fetch
        # subject to normal HTTP caching — unlike the top-level sw.js fetch,
        # which the SW update algorithm force-revalidates. Without this line
        # push-sw.js matches none of the matchers below and falls through to
        # the bare file_server with no explicit Cache-Control, leaving the
        # browser to apply its own heuristic freshness lifetime — so a deploy
        # that changes only push-sw.js (leaving the generated sw.js
        # byte-identical) could go unnoticed on an already-installed device.
        @nocache path /sw.js /registerSW.js /manifest.webmanifest /push-sw.js
        header @nocache Cache-Control "no-cache"

        # Content-hashed assets (Vite output: /assets/index-Bb5kahVl.js etc.) are
        # safe to cache forever — any content change produces a new filename.
        @immutable path /assets/*
        header @immutable Cache-Control "public, max-age=31536000, immutable"

        # Our own Maia worker glue is NOT content-hashed and its message protocol
        # changes with the app bundle — never cache it (same reason as /sw.js above;
        # quick 260729-sod FIX 4). Excluded from the vendored-runtime rule below via
        # `not path`, so ordering between the two `header` directives never matters.
        @maiaworker path /maia/maia-worker.js
        header @maiaworker Cache-Control "no-cache"

        # Vendored, version-pinned runtime binaries (the 43.6 MB Maia ONNX model +
        # onnxruntime-web builds, Stockfish glue + wasm). NOT content-hashed, so this
        # is NOT `immutable`. 30 days is long enough that a returning mobile visitor
        # never re-downloads 43.6 MB over a slow link (the `Load failed` /
        # `Importing a module script is canceled` cluster in 260729-sod-FINDINGS.md
        # §5), short enough that a stale ORT/Stockfish build self-heals within a
        # month even if a version bump were somehow missed.
        #
        # Quick 260905-rhc: every path under /maia/ and /engine/ this app requests
        # now carries a `?v=<n>` query derived from ENGINE_ASSET_CACHE_VERSION
        # (frontend/src/lib/engine/engineAssetCache.ts). Cloudflare's edge cache (the
        # actual trigger for this fix — see engineAssetCache.ts's file header) keys a
        # cached response on the FULL URL including its query string, so bumping that
        # one constant makes every edge entry unreachable instead of waiting out
        # max-age: no directive or matcher here changes as a result, only the
        # requested URLs do.
        @vendored_runtime {
            path /maia/* /engine/*
            not path /maia/maia-worker.js
        }
        header @vendored_runtime Cache-Control "public, max-age=2592000"

        file_server
    }

    # Backend API — single rule, all backend routes are under /api/
    handle /api/* {
        reverse_proxy backend:8000
    }

    # SPA fallback — all remaining paths get index.html
    handle {
        root * /srv
        header /index.html Cache-Control "no-cache"
        try_files /index.html
        file_server
    }
}
