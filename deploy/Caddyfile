flawchess.org, www.flawchess.org {
    redir https://flawchess.com{uri} permanent
}

analytics.flawchess.com {
    reverse_proxy umami:3000
}

flawchess.com {
    encode gzip

    # Access log. Without this Caddy logs NOTHING about requests, so any status
    # Caddy produces on its own — above all the 502 it returns while the backend
    # container restarts, and any 5xx that therefore never reaches FastAPI or the
    # backend's Sentry — leaves no server-side trace at all. The only evidence was
    # whatever the browser happened to report (FLAWCHESS-64), which is sampled,
    # client-side, and useless for reconstructing an outage after the fact.
    #
    # stdout keeps `docker compose logs caddy` as the single inspection path.
    # Volume is bounded by the `logging:` limits on the caddy service in
    # docker-compose.yml — Docker's json-file default has NO rotation, and this
    # host has no /etc/docker/daemon.json, so without those limits an access log
    # grows until the 160 GB disk fills.
    #
    # SECRET REDACTION. Caddy redacts Authorization and Cookie by default, but
    # NOTHING else — and this app carries two credentials those defaults miss.
    # Both leaked into prod for ~40 minutes after the log was first enabled:
    #   1. X-Operator-Token — the SHARED remote-worker secret, sent on every
    #      eval-worker poll (app/routers/eval_remote.py:169). Worker polling is
    #      the bulk of API traffic, so it appeared in most log lines.
    #   2. ?token= — password-reset links are FRONTEND_URL/auth/reset-password
    #      ?token=<token> (app/users.py:131). That is an SPA route, not /api/*,
    #      so it is NOT covered by log_skip below and its query string is logged
    #      in full. The token grants account takeover.
    # Any NEW credential that travels in a header or query string must be added
    # here BEFORE it can reach production.
    log {
        output stdout
        format filter {
            wrap json
            fields {
                request>headers>X-Operator-Token replace REDACTED
                request>uri query {
                    replace token REDACTED
                }
            }
        }
    }

    # Frontend SPA — serve static files first
    # If the file exists on disk (JS, CSS, images, etc.), serve it directly
    @static file
    handle @static {
        # Static assets are served by Caddy itself and can never 502, so they
        # carry no diagnostic value — and logging every hashed chunk plus the
        # 43.6 MB Maia model would drown the API entries this log exists for.
        log_skip

        root * /srv

        # Service worker and PWA manifest must never be HTTP-cached so browsers
        # detect new deployments immediately on every page load (SW spec requires
        # revalidation, but no-cache enforces it on every request, not just every 24h).
        # /push-sw.js joins this matcher too: it is pulled in by the generated
        # service worker via importScripts(), an ordinary sub-resource fetch
        # subject to normal HTTP caching — unlike the top-level sw.js fetch,
        # which the SW update algorithm force-revalidates. Without this line
        # push-sw.js matches none of the matchers below and falls through to
        # the bare file_server with no explicit Cache-Control, leaving the
        # browser to apply its own heuristic freshness lifetime — so a deploy
        # that changes only push-sw.js (leaving the generated sw.js
        # byte-identical) could go unnoticed on an already-installed device.
        @nocache path /sw.js /registerSW.js /manifest.webmanifest /push-sw.js
        header @nocache Cache-Control "no-cache"

        # Content-hashed assets (Vite output: /assets/index-Bb5kahVl.js etc.) are
        # safe to cache forever — any content change produces a new filename.
        @immutable path /assets/*
        header @immutable Cache-Control "public, max-age=31536000, immutable"

        # Our own Maia worker glue is NOT content-hashed and its message protocol
        # changes with the app bundle — never cache it (same reason as /sw.js above;
        # quick 260729-sod FIX 4). Excluded from the vendored-runtime rule below via
        # `not path`, so ordering between the two `header` directives never matters.
        @maiaworker path /maia/maia-worker.js
        header @maiaworker Cache-Control "no-cache"

        # Vendored, version-pinned runtime binaries (the 43.6 MB Maia ONNX model +
        # onnxruntime-web builds, Stockfish glue + wasm). NOT content-hashed — ORT
        # resolves its own .wasm/.mjs filenames by appending them to wasmPaths =
        # '/maia/', so renaming without also versioning the directory would break
        # asset resolution — so this is NOT `immutable`. 30 days is long enough that
        # a returning mobile visitor never re-downloads 43.6 MB over a slow link (the
        # `Load failed` / `Importing a module script is canceled` cluster in
        # 260729-sod-FINDINGS.md §5), short enough that a stale ORT/Stockfish build
        # self-heals within a month with zero process discipline required of the next
        # upgrader.
        @vendored_runtime {
            path /maia/* /engine/*
            not path /maia/maia-worker.js
        }
        header @vendored_runtime Cache-Control "public, max-age=2592000"

        file_server
    }

    # Backend API — single rule, all backend routes are under /api/
    handle /api/* {
        reverse_proxy backend:8000
    }

    # SPA fallback — all remaining paths get index.html
    handle {
        root * /srv
        header /index.html Cache-Control "no-cache"
        try_files /index.html
        file_server
    }
}
