{
  // Frontend production-dependency vulnerability gate (replaces the raw
  // `npm audit --audit-level=high --omit=dev` CI step). Fails CI on any
  // high/critical advisory in a production dependency EXCEPT the explicitly
  // allowlisted ones below. Keep this list minimal and justified — every
  // entry is a deliberate risk-acceptance, not a mute button.
  "$schema": "https://github.com/IBM/audit-ci/raw/main/docs/schema.json",
  "high": true,
  "skip-dev": true,
  // Empty is the goal state. Both former entries were react-router advisories,
  // and both are now genuinely fixed rather than accepted:
  //   GHSA-chx6-hx7r-mcp5 (DoS via inefficient route matching) — dropped 2026-08-05,
  //     patched in 7.18.0.
  //   GHSA-qwww-vcr4-c8h2 (RSC Mode CSRF Bypass) — dropped 2026-08-07. No 7.x release
  //     ever cleared it and react-router-dom was discontinued at 7.18.2, so we migrated
  //     to the react-router package at 8.3.0 instead of carrying the risk acceptance.
  "allowlist": []
}
